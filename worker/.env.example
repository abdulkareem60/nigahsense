# Copy to worker/.env. Never commit worker/.env.

# Where the FastAPI backend is running
NIGAHSENSE_API_URL=http://127.0.0.1:8000

# Must equal one of the values in backend/.env WORKER_API_KEYS
NIGAHSENSE_WORKER_KEY=replace-with-the-same-secret-as-backend

NIGAHSENSE_REQUEST_TIMEOUT_SECONDS=10
NIGAHSENSE_MAX_SEND_ATTEMPTS=8

# Only for source.type = "rtsp". Keep the camera password here, not in the TOML config.
# NIGAHSENSE_RTSP_URL=rtsp://user:password@192.168.1.64:554/Streaming/Channels/101
