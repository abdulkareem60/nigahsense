# Copy to backend/.env for local development. Never commit backend/.env.

APP_ENV=development
FIREBASE_PROJECT_ID=demo-nigahsense

# firestore = Firestore (emulator or cloud). memory = in-process, data lost on restart.
STORAGE_BACKEND=firestore

# Firebase Emulator Suite (local only; must be empty in production)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Shared secret(s) the vision worker sends in X-Worker-Key. Comma-separated to allow rotation.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_API_KEYS=replace-with-a-generated-secret

# Firebase custom-claim roles allowed to use operator endpoints
OPERATOR_ROLES=operator,supervisor,admin

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Production only: path to a service-account key stored OUTSIDE the repository,
# or leave unset to use the host's Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=
